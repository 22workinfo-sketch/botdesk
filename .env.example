# -----------------------------------------------------------------------------
# BackStage Environment Configuration (Example / Template)
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file or paste real credentials in chat.
# -----------------------------------------------------------------------------

# Database Connection
# Local Docker PostgreSQL:
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/backstage_db?schema=public&connection_limit=25&pool_timeout=20"
# Remote Neon Serverless PostgreSQL (For Render Free testing):
# Format: "postgresql://USER:PASSWORD@ep-xyz-pooler.us-east-2.aws.neon.tech/backstage_test_db?sslmode=require"

# Admin Authentication Session Secret
# Generate a secure 32+ character random secret (e.g. `openssl rand -hex 32`)
# Required in production: will refuse to run if left as default/fallback.
ADMIN_SESSION_SECRET="change-this-to-a-secure-random-32-plus-character-secret-key"

# Bot Token Encryption Key (AES-256-GCM)
# Generate a separate secure 32-byte (64 hex characters) encryption key:
# e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
# MUST be different from ADMIN_SESSION_SECRET. Never commit real keys.
BOT_TOKEN_ENCRYPTION_KEY="your_64_character_hex_bot_token_encryption_key_here"

# Initial Admin User Credentials (Used ONLY by local `npm run db:seed`)
# Do NOT configure or use default credentials in public/cloud deployments.
ADMIN_DEFAULT_EMAIL="admin@local.test"
ADMIN_DEFAULT_PASSWORD="change_me_local_password_123"

# Telegram Bot Credentials
# Obtain from https://t.me/BotFather for your NEW test bot
TELEGRAM_BOT_TOKEN="your_test_bot_token_from_botfather_here"

# Telegram Bot Execution Mode
# "polling" (Default for local development via `npm run bot`)
# "webhook" (Required for single-service cloud deployments on Render Free)
TELEGRAM_MODE="polling"

# Telegram Webhook Security Secret
# High-entropy secret token passed in X-Telegram-Bot-Api-Secret-Token header
# Telegram allows 1-256 characters: [A-Za-z0-9_-]
TELEGRAM_WEBHOOK_SECRET="your_webhook_secret_token_at_least_32_chars"

# Public Webhook URL (Required when setting webhook with BotFather / Telegram API)
# Example: "https://your-app-name.onrender.com/api/telegram/webhook"
WEBHOOK_URL="https://your-app-name.onrender.com/api/telegram/webhook"

# Default Test Bot Metadata
BOT_DEFAULT_ID="00000000-0000-0000-0000-000000000001"
BOT_DEFAULT_NAME="Local Test Bot"
BOT_DEFAULT_USERNAME="local_test_bot"

# Application Environment
NODE_ENV="development"
PORT=3000

# Media Object Storage Configuration
# "local" (Default for local development, stores in uploads/posts)
# "s3" or "r2" (For Cloudflare R2 or S3-compatible cloud object storage)
STORAGE_PROVIDER="local"

# S3 / Cloudflare R2 Settings (Required ONLY when STORAGE_PROVIDER="s3" or "r2")
# Cloudflare R2 Endpoint: "https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
S3_ENDPOINT="https://your_cloudflare_account_id.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET_NAME="backstage-media"
S3_ACCESS_KEY_ID="your_s3_or_r2_access_key_id"
S3_SECRET_ACCESS_KEY="your_s3_or_r2_secret_access_key"
